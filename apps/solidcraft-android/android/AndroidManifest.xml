<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.solidcraft.matepad">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />

    <application
        android:label="SolidCraft MatePad"
        android:hasCode="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name="dev.solidcraft.matepad.MatePadActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|density|uiMode"
            android:screenOrientation="sensorLandscape">
            <meta-data
                android:name="android.app.lib_name"
                android:value="solidcraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
